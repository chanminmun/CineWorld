{
  "family": "cineworld-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::808243603066:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::808243603066:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "cineworld-container",
      "image": "808243603066.dkr.ecr.ap-northeast-2.amazonaws.com/cineworld:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "SECRET_KEY", "value": "__SECRET_KEY__" },
        { "name": "DEBUG", "value": "__DEBUG__" },
        { "name": "ALLOWED_HOSTS", "value": "__ALLOWED_HOSTS__" },
        { "name": "DB_NAME", "value": "__DB_NAME__" },
        { "name": "DB_USER", "value": "__DB_USER__" },
        { "name": "DB_PASSWORD", "value": "__DB_PASSWORD__" },
        { "name": "DB_HOST", "value": "__DB_HOST__" },
        { "name": "DB_PORT", "value": "__DB_PORT__" },
        { "name": "TMDB_BEARER_TOKEN", "value": "__TMDB_BEARER_TOKEN__" },
        { "name": "KOBIS_API_KEY", "value": "__KOBIS_API_KEY__" }
        ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/cineworld",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}